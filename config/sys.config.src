[
    {hpr, [
        {data_dir, "/var/data"},
        %% See https://github.com/helium/HIP/blob/main/0102-helium-educational-lns.md
        {hpr_free_net_ids, [16#C00053]},
        {http_roaming_sender_nsid, <<"${HPR_ROAMING_SENDER_NSID}">>},
        {no_routes, []},
        %% Elli metrics endpoint port. Quoted so an unset variable cannot break
        %% the term file; empty or unparseable falls back to 3000.
        {metrics_port, "${HPR_METRICS_PORT}"},
        {packet_reporter, #{
            aws_bucket => <<"${HPR_PACKET_REPORTER_AWS_BUCKET}">>,
            %% Set aws_endpoint for an S3-compatible provider, e.g.
            %% <<"https://t3.storageapi.dev">>; the key/secret below are then
            %% required. Leave it empty for real AWS S3 in aws_bucket_region, with
            %% credentials from the aws_credentials provider chain.
            aws_endpoint => <<"${HPR_PACKET_REPORTER_AWS_ENDPOINT}">>,
            aws_bucket_region => <<"${HPR_PACKET_REPORTER_AWS_BUCKET_REGION}">>,
            aws_access_key_id => <<"${HPR_PACKET_REPORTER_AWS_KEY}">>,
            aws_secret_access_key => <<"${HPR_PACKET_REPORTER_AWS_SECRET}">>,
            report_interval => 300_000,
            report_max_size => 50_000_000
        }},
        {gateway_liveness_reporter, #{
            aws_bucket => <<"${HPR_LIVENESS_REPORTER_AWS_BUCKET}">>,
            %% See packet_reporter above for the endpoint / region rule.
            aws_endpoint => <<"${HPR_LIVENESS_REPORTER_AWS_ENDPOINT}">>,
            aws_bucket_region => <<"${HPR_LIVENESS_REPORTER_AWS_BUCKET_REGION}">>,
            aws_access_key_id => <<"${HPR_LIVENESS_REPORTER_AWS_KEY}">>,
            aws_secret_access_key => <<"${HPR_LIVENESS_REPORTER_AWS_SECRET}">>,
            %% Name this instance reports itself as. Leave empty to use the
            %% hostname; set it where the hostname is meaningless.
            server_name => <<"${HPR_LIVENESS_REPORTER_SERVER_NAME}">>,
            %% ecron 6-field spec (sec min hour dom month dow): daily at midnight
            report_interval => <<"0 0 0 * * *">>,
            %% ecron 6-field spec: hourly
            checkpoint_interval => <<"0 0 * * * *">>,
            %% post-report cleanup: drop entries not seen in the last 5 min
            stale_threshold => 300_000
        }},
        {iot_config_service, #{
            transport => "${HPR_IOT_CONFIG_TRANSPORT}",
            host => "${HPR_IOT_CONFIG_HOST}",
            port => "${HPR_IOT_CONFIG_PORT}"
        }},
        {iot_location_service, #{
            transport => "${HPR_IOT_LOCATION_TRANSPORT}",
            host => "${HPR_IOT_LOCATION_HOST}",
            port => "${HPR_IOT_LOCATION_PORT}"
        }},
        {downlink_service, #{
            transport => "${HPR_DOWNLINK_SERVICE_TRANSPORT}",
            host => "${HPR_DOWNLINK_SERVICE_HOST}",
            port => "${HPR_DOWNLINK_SERVICE_PORT}"
        }},
        %% Quoted, unlike every other placeholder here, because this one used to
        %% be bare: an unset HPR_MULTI_BUY_ENABLED produced `{multi_buy_enabled, }`
        %% and the whole sys.config failed to parse, so HPR would not boot at all
        %% with a syntax error that named nothing useful. hpr_multi_buy:enabled/0
        %% coerces the string.
        {multi_buy_enabled, "${HPR_MULTI_BUY_ENABLED}"},
        {multi_buy_service, #{
            transport => "${HPR_MULTI_BUY_SERVICE_TRANSPORT}",
            host => "${HPR_MULTI_BUY_SERVICE_HOST}",
            port => "${HPR_MULTI_BUY_SERVICE_PORT}"
        }},
        %% Packet router GRPC server. Started under hpr_sup as the last child so
        %% we don't accept gateway connections before HPR is fully initialized.
        {packet_router_server, #{
            grpc_opts => #{
                service_protos => [packet_router_pb],
                services => #{
                    'helium.packet_router.packet' => hpr_packet_router_service
                }
            },
            transport_opts => #{ssl => false},
            listen_opts => #{
                port => 8080,
                ip => {0, 0, 0, 0}
            },
            pool_opts => #{size => 500},
            server_opts => #{
                header_table_size => 4096,
                enable_push => 1,
                max_concurrent_streams => unlimited,
                initial_window_size => 16777216,
                max_frame_size => 16384,
                max_header_list_size => unlimited
            }
        }},
        {routing_cache_timeout_secs, 15},
        {routing_cache_window_secs, 120},
        %% Reset the config stream after it delivers nothing for this long; 0
        %% disables. See hpr_route_stream_worker, "Silent stream".
        {ics_stream_silence_secs, 600},
        {ics_stream_worker_checkpoint_secs, 300},
        %% How long a multi-buy dedup key lives, and how often the expiry sweep
        %% runs. Deliberately separate: one sweep over a whole TTL's worth of
        %% rows contends with every in-flight packet.
        {multi_buy_window_secs, 120},
        {multi_buy_cleanup_secs, 15},
        %% Multi-buy grpc deadline. Under the 1s Class A RX1 window, because a
        %% later answer is unusable and only costs a parked process.
        {multi_buy_timeout_ms, 500},
        %% Per-second ceiling on gateway location lookups to iot-config, which
        %% share one connection. Stops a cold cache plus a reconnect wave firing
        %% one lookup per gateway at once.
        {gateway_location_rate_limit, 100},
        %% erlang:system_monitor thresholds. Nothing reported VM stalls before
        %% these, which is how a multi-second stall left no trace in the logs.
        {sysmon_long_gc_ms, 500},
        {sysmon_long_schedule_ms, 500},
        {sysmon_logs_per_sec, 10}
    ]},
    %% Used only by reporters that set no aws_endpoint. A reporter pointed at an
    %% S3-compatible endpoint authenticates with its own key/secret above and
    %% never consults this chain.
    {aws_credentials, [
        {credential_providers, [aws_credentials_env, aws_credentials_ec2]}
    ]},
    {chatterbox, [
        {client_initial_window_size, 16777216},
        {server_initial_window_size, 16777216}
    ]},
    %% The packet router GRPC server is no longer auto-started by grpcbox here;
    %% it is started as the last child of hpr_sup (see {hpr, packet_router_server}).
    {grpcbox, []},
    {lager, [
        {suppress_supervisor_start_stop, true},
        {log_root, "/var/log/hpr"},
        {crash_log, "crash.log"},
        %% Overload. By default lager turns synchronous once 20 messages are
        %% queued on it, and every process that logs then waits for its line to
        %% be written: a burst of errors stalls packet and stream processes
        %% across the node. Here it stays asynchronous and sheds a backlog
        %% instead. info.log drops lines past 1000/s (below), and past 5000
        %% queued, lager's event manager is killed, discarding its queue, and
        %% its handlers are reinstalled within ~5s. Lines logged in a flood are
        %% lost, but no caller waits on lager.
        %% killer_hwm is only safe because lager never goes synchronous: killed
        %% while callers wait on it, every one of them would crash.
        {async_threshold, 1000000},
        {async_threshold_window, 200000},
        {killer_hwm, 5000},
        {killer_reinstall_after, 5000},
        {handlers, [
            {lager_console_backend, [{level, info}]},
            {lager_file_backend, [
                {file, "info.log"},
                {level, info},
                %% Past 1000 lines in a second, drop the rest of that second,
                %% and once 500 are queued also discard what is queued: a
                %% moderate flood is shed here before killer_hwm is reached.
                %% Lager logs how many it dropped. The queue is shared, so the
                %% discarded lines skip the console too.
                {high_water_mark, 1000},
                {flush_queue, true},
                {flush_threshold, 500},
                {size, 0},
                {date, "$D0"},
                {count, 7},
                {formatter_config, [
                    "time=",
                    date,
                    "T",
                    time,
                    " lvl=",
                    severity_upper,
                    " ",
                    metadata,
                    " msg=\"",
                    message,
                    "\"",
                    "\n"
                ]}
            ]}
        ]}
    ]},
    {prometheus, [
        {collectors, [
            prometheus_boolean,
            prometheus_counter,
            prometheus_gauge,
            prometheus_histogram,
            prometheus_vm_memory_collector,
            prometheus_vm_system_info_collector
        ]},
        {vm_system_info_collector_metrics, [process_count, port_count]}
    ]}
].
